{
  "name": "gaugestudio",
  "version": "0.1.0",
  "description": "Gauge test management desktop app (Electron + Vue3 + Element Plus)",
  "author": "Linhanmic",
  "license": "MIT",
  "homepage": "https://github.com/Linhanmic/GaugeStudio",
  "repository": {
    "type": "git",
    "url": "https://github.com/Linhanmic/GaugeStudio.git"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --win zip",
    "dist:zip": "npm run build && electron-builder --win zip",
    "dist:setup": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.9.8",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "electron": "^35.1.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0"
  },
  "build": {
    "appId": "com.gaugestudio.app",
    "productName": "GaugeStudio",
    "copyright": "Copyright © GaugeStudio",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/"
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "${productName}-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GaugeStudio",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "publish": null
  }
}
